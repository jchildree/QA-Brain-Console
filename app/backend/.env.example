ANTHROPIC_API_KEY=
PORT=4000
NODE_ENV=production
SESSION_SECRET=
# Users are not set here -- run: node scripts/create-user.js <username> <password>
# AUTH_USERS_FILE=./data/users.json
FRONTEND_ORIGIN=http://localhost:5173
AI_PROVIDER=anthropic
CUSTOM_AI_ENDPOINT=

# Web Push Notifications (generate via: node -e "const webpush = require('web-push'); const {publicKey, privateKey} = webpush.generateVAPIDKeys(); console.log('Public:', publicKey); console.log('Private:', privateKey);")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
